# Connexion à la même base Postgres que le backend Django (lecture seule).
# Laissé tel quel pour Docker Compose (le service s'appelle "db").
DATABASE_URL=postgresql://sama_user:sama_password@db:5432/sama_terrain

# Clé API OpenRouter (https://openrouter.ai/keys) : à remplir toi-même.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
